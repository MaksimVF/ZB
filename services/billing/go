package main

import (
	"context"
	"fmt"
	"log"
	"net"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/redis/go-redis/v9"
	"google.golang.org/grpc"
)

// Config конфигурация сервиса
type Config struct {
	Port        int
	RedisURL    string
	Env         string
	ExternalURL string
}

// PricingService структура сервиса ценообразования
type PricingService struct {
	redis  *redis.Client
	config Config
	models map[string]map[string]float64 // model -> endpoint -> price
}

// NewPricingService создание нового сервиса
func NewPricingService(config Config) *PricingService {
	redisClient := redis.NewClient(&redis.Options{
		Addr: config.RedisURL,
	})

	return &PricingService{
		redis:  redisClient,
		config: config,
		models: map[string]map[string]float64{
			"gpt-4o": {
				"chat":  0.005, // per 1K tokens
				"embed": 0.0001,
			},
			"gpt-4o-mini": {
				"chat":  0.00015,
				"embed": 0.00001,
			},
			"claude-3-sonnet": {
				"chat":  0.003,
				"embed": 0.0003,
			},
		},
	}
}

// GetPrice получение цены для модели и эндпоинта
func (s *PricingService) GetPrice(ctx context.Context, model, endpoint string) (float64, error) {
	if prices, exists := s.models[model]; exists {
		if price, exists := prices[endpoint]; exists {
			return price, nil
		}
	}
	return 0, fmt.Errorf("pricing not found for model %s endpoint %s", model, endpoint)
}

// UpdatePricing обновление ценообразования
func (s *PricingService) UpdatePricing(ctx context.Context, model, endpoint string, price float64) error {
	// Обновляем локальную модель
	if _, exists := s.models[model]; !exists {
		s.models[model] = make(map[string]float64)
	}
	s.models[model][endpoint] = price

	// Сохраняем в Redis
	pricingData := map[string]interface{}{
		"model":    model,
		"endpoint": endpoint,
		"price":    price,
		"updated":  time.Now().Unix(),
	}

	err := s.redis.HSet(ctx, "pricing:"+model, pricingData).Err()
	if err != nil {
		return fmt.Errorf("failed to save pricing to Redis: %w", err)
	}

	return nil
}

// GetAllPricing получение всего ценообразования
func (s *PricingService) GetAllPricing(ctx context.Context) (map[string]map[string]float64, error) {
	return s.models, nil
}

// gRPC Server реализация
type PricingGRPCServer struct {
	service *PricingService
}

func main() {
	config := Config{
		Port:     50054,
		RedisURL: getRedisURL(),
		Env:      getEnv(),
	}

	service := NewPricingService(config)
	server := &PricingGRPCServer{service: service}

	// Запуск gRPC сервера
	lis, err := net.Listen("tcp", fmt.Sprintf(":%d", config.Port))
	if err != nil {
		log.Fatalf("Failed to listen: %v", err)
	}

	grpcServer := grpc.NewServer()

	// TODO: Регистрация gRPC сервисов
	// pb.RegisterPricingServiceServer(grpcServer, server)

	log.Printf("Pricing Service starting on port %d", config.Port)

	// Graceful shutdown
	go func() {
		<-shutdown()
		log.Println("Shutting down Pricing Service...")
		grpcServer.GracefulStop()
	}()

	if err := grpcServer.Serve(lis); err != nil {
		log.Fatalf("Failed to serve: %v", err)
	}
}

// Вспомогательные функции
func getRedisURL() string {
	if url := os.Getenv("REDIS_URL"); url != "" {
		return url
	}
	return "localhost:6379"
}

func getEnv() string {
	if env := os.Getenv("ENV"); env != "" {
		return env
	}
	return "development"
}

// graceful shutdown handling
func shutdown() <-chan struct{} {
	shutdown := make(chan struct{})

	go func() {
		defer close(shutdown)
		sigChan := make(chan os.Signal, 1)
		signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)
		<-sigChan
	}()

	return shutdown
}
