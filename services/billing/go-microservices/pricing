// UpdatePricing godoc
// @Summary Update pricing for a model
// @Description Update pricing information for a specific model
// @Tags pricing
// @Param model_id path string true "Model ID"
// @Param request body models.UpdatePricingRequest true "Pricing update request"
// @Success 200 {object} models.UpdatePricingResponse
// @Failure 400 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /pricing/{model_id} [put]
func (h *PricingHandler) UpdatePricing(c *gin.Context) {
	modelID := c.Param("model_id")
	if modelID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Model ID is required",
			Code:  "INVALID_MODEL_ID",
		})
		return
	}

	var request models.UpdatePricingRequest
	if err := c.ShouldBindJSON(&request); err != nil {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Invalid request body",
			Code:  "INVALID_JSON",
		})
		return
	}

	// Validate model ID matches
	if request.ModelID != modelID {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Model ID mismatch",
			Code:  "MODEL_ID_MISMATCH",
		})
		return
	}

	ctx, cancel := context.WithTimeout(c.Request.Context(), 10*time.Second)
	defer cancel()

	err := h.pricingService.UpdatePricing(ctx, &request)
	if err != nil {
		c.JSON(http.StatusInternalServerError, ErrorResponse{
			Error: "Failed to update pricing",
			Code:  "UPDATE_FAILED",
		})
		return
	}

	c.JSON(http.StatusOK, models.UpdatePricingResponse{
		Success:   true,
		Message:   "Pricing updated successfully",
		UpdatedAt: time.Now(),
		ModelID:   modelID,
	})
}

