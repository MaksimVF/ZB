// CalculateCost godoc
// @Summary Calculate cost for token usage
// @Description Calculate the cost for given input and output tokens
// @Tags pricing
// @Param model_id query string true "Model ID"
// @Param input_tokens query int true "Number of input tokens"
// @Param output_tokens query int true "Number of output tokens"
// @Success 200 {object} map[string]interface{}
// @Failure 400 {object} ErrorResponse
// @Failure 404 {object} ErrorResponse
// @Router /pricing/calculate [get]
func (h *PricingHandler) CalculateCost(c *gin.Context) {
	modelID := c.Query("model_id")
	inputTokens := c.Query("input_tokens")
	outputTokens := c.Query("output_tokens")

	if modelID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Model ID is required",
			Code:  "INVALID_MODEL_ID",
		})
		return
	}

	if inputTokens == "" || outputTokens == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Input and output tokens are required",
			Code:  "INVALID_TOKENS",
		})
		return
	}

	var inputTokensInt, outputTokensInt int
	fmt.Sscanf(inputTokens, "%d", &inputTokensInt)
	fmt.Sscanf(outputTokens, "%d", &outputTokensInt)

	if inputTokensInt < 0 || outputTokensInt < 0 {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Token counts must be non-negative",
			Code:  "INVALID_TOKEN_COUNT",
		})
		return
	}

	ctx, cancel := context.WithTimeout(c.Request.Context(), 5*time.Second)
	defer cancel()

	pricingModel, err := h.pricingService.GetPricing(ctx, modelID)
	if err != nil {
		c.JSON(http.StatusNotFound, ErrorResponse{
			Error: "Pricing not found for model",
			Code:  "PRICING_NOT_FOUND",
		})
		return
	}

	cost := pricingModel.CalculateCost(inputTokensInt, outputTokensInt)

	c.JSON(http.StatusOK, gin.H{
		"model_id":       modelID,
		"input_tokens":   inputTokensInt,
		"output_tokens":  outputTokensInt,
		"total_cost":     cost,
		"input_cost":     float64(inputTokensInt) * pricingModel.GetTokenPrice("input"),
		"output_cost":    float64(outputTokensInt) * pricingModel.GetTokenPrice("output"),
	})
}

