// SyncWithExternal godoc
// @Summary Sync pricing with external source
// @Description Sync pricing data with external pricing source
// @Tags pricing
// @Param request body map[string]interface{} true "Sync request"
// @Success 200 {object} models.BulkUpdatePricingResponse
// @Failure 400 {object} ErrorResponse
// @Failure 500 {object} ErrorResponse
// @Router /pricing/sync [post]
func (h *PricingHandler) SyncWithExternal(c *gin.Context) {
	var request map[string]interface{}
	if err := c.ShouldBindJSON(&request); err != nil {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Invalid request body",
			Code:  "INVALID_JSON",
		})
		return
	}

	sourceURL, ok := request["source_url"].(string)
	if !ok || sourceURL == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Source URL is required",
			Code:  "INVALID_SOURCE_URL",
		})
		return
	}

	ctx, cancel := context.WithTimeout(c.Request.Context(), 60*time.Second)
	defer cancel()

	response, err := h.pricingService.SyncWithExternal(ctx, sourceURL)
	if err != nil {
		c.JSON(http.StatusInternalServerError, ErrorResponse{
			Error: "Failed to sync with external source",
			Code:  "SYNC_FAILED",
		})
		return
	}

	c.JSON(http.StatusOK, response)
}

// gRPC handlers

// GetPricing implements pb.PricingServiceServer
func (h *PricingHandler) GetPricing(ctx context.Context, req *pb.GetPricingRequest) (*pb.GetPricingResponse, error) {
	if req.ModelId == "" {
		return nil, fmt.Errorf("model ID is required")
	}

	pricingModel, err := h.pricingService.GetPricing(ctx, req.ModelId)
	if err != nil {
		if err == ErrPricingNotFound {
			return &pb.GetPricingResponse{
				Success: false,
				Error:   "Pricing not found",
			}, nil
		}
		return nil, fmt.Errorf("failed to get pricing: %w", err)
	}

	// Convert internal model to protobuf
	pbModel := &pb.PricingModel{
		Id:          pricingModel.ID,
		Name:        pricingModel.Name,
		Provider:    pricingModel.Provider,
		CreatedAt:   pricingModel.CreatedAt.Unix(),
		UpdatedAt:   pricingModel.UpdatedAt.Unix(),
		Active:      pricingModel.Active,
	}

	// Convert pricing map
	pbModel.Pricing = make(map[string]*pb.PricingType)
	for tokenType, pricing := range pricingModel.Pricing {
		pbModel.Pricing[tokenType] = &pb.PricingType{
			Input:  pricing.Input,
			Output: pricing.Output,
			Embed:  pricing.Embed,
		}
	}

	return &pb.GetPricingResponse{
		Success: true,
		Model:   pbModel,
	}, nil
}

// UpdatePricing implements pb.PricingServiceServer
func (h *PricingHandler) UpdatePricing(ctx context.Context, req *pb.UpdatePricingRequest) (*pb.UpdatePricingResponse, error) {
	if req.ModelId == "" {
		return nil, fmt.Errorf("model ID is required")
	}

	updateRequest := &models.UpdatePricingRequest{
		ModelID: req.ModelId,
		Pricing: models.PricingType{
			Input:  req.Pricing.Input,
			Output: req.Pricing.Output,
			Embed:  req.Pricing.Embed,
		},
		Source: req.Source,
	}

	err := h.pricingService.UpdatePricing(ctx, updateRequest)
	if err != nil {
		return nil, fmt.Errorf("failed to update pricing: %w", err)
	}

	return &pb.UpdatePricingResponse{
		Success:   true,
		Message:   "Pricing updated successfully",
		UpdatedAt: time.Now().Unix(),
		ModelId:   req.ModelId,
	}, nil
}

// CalculateCost implements pb.PricingServiceServer
func (h *PricingHandler) CalculateCost(ctx context.Context, req *pb.CalculateCostRequest) (*pb.CalculateCostResponse, error) {
	if req.ModelId == "" {
		return nil, fmt.Errorf("model ID is required")
	}

	if req.InputTokens < 0 || req.OutputTokens < 0 {
		return nil, fmt.Errorf("token counts must be non-negative")
	}

	pricingModel, err := h.pricingService.GetPricing(ctx, req.ModelId)
	if err != nil {
		return nil, fmt.Errorf("pricing not found for model: %w", err)
	}

	totalCost := pricingModel.CalculateCost(int(req.InputTokens), int(req.OutputTokens))
	inputCost := float64(req.InputTokens) * pricingModel.GetTokenPrice("input")
	outputCost := float64(req.OutputTokens) * pricingModel.GetTokenPrice("output")

	return &pb.CalculateCostResponse{
		ModelId:       req.ModelId,
		InputTokens:   req.InputTokens,
		OutputTokens:  req.OutputTokens,
		TotalCost:     totalCost,
		InputCost:     inputCost,
		OutputCost:    outputCost,
		CalculatedAt:  time.Now().Unix(),
	}, nil
}

// ErrorResponse represents error response structure
type ErrorResponse struct {
	Error string `json:"error"`
	Code  string `json:"code"`
}