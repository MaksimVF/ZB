// PricingHandler handles pricing-related HTTP requests
type PricingHandler struct {
	pricingService *PricingService
	redisClient    *redis.Client
}

// NewPricingHandler creates new pricing handler
func NewPricingHandler(pricingService *PricingService, redisClient *redis.Client) *PricingHandler {
	return &PricingHandler{
		pricingService: pricingService,
		redisClient:    redisClient,
	}
}

// GetPricing godoc
// @Summary Get pricing for a model
// @Description Retrieve pricing information for a specific model
// @Tags pricing
// @Param model_id path string true "Model ID"
// @Success 200 {object} models.PricingModel
// @Failure 400 {object} ErrorResponse
// @Failure 404 {object} ErrorResponse
// @Router /pricing/{model_id} [get]
func (h *PricingHandler) GetPricing(c *gin.Context) {
	modelID := c.Param("model_id")
	if modelID == "" {
		c.JSON(http.StatusBadRequest, ErrorResponse{
			Error: "Model ID is required",
			Code:  "INVALID_MODEL_ID",
		})
		return
	}

	ctx, cancel := context.WithTimeout(c.Request.Context(), 5*time.Second)
	defer cancel()

	pricingModel, err := h.pricingService.GetPricing(ctx, modelID)
	if err != nil {
		if err == ErrPricingNotFound {
			c.JSON(http.StatusNotFound, ErrorResponse{
				Error: "Pricing not found for model",
				Code:  "PRICING_NOT_FOUND",
			})
			return
		}

		c.JSON(http.StatusInternalServerError, ErrorResponse{
			Error: "Failed to get pricing",
			Code:  "INTERNAL_ERROR",
		})
		return
	}

	c.JSON(http.StatusOK, pricingModel)
}

